# 将此文件复制为 .env，然后填写你自己的服务端 API 密钥。不要把 .env 上传到公开仓库。
AI_API_KEY=
AI_API_BASE=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# 图像识别必须配置支持图片输入的 OpenAI-compatible 视觉模型。
# DeepSeek 文本模型本身不等同于视觉识别服务。
VISION_API_KEY=
VISION_API_BASE=
VISION_MODEL=

# 可选：请求安全与本地运行参数
AI_RATE_LIMIT_PER_MINUTE=12
AI_TIMEOUT_SECONDS=45
BIND_HOST=127.0.0.1
PORT=8000
